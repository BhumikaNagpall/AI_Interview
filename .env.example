# Optional local configuration. Copy to .env; never commit real credentials.
# npm start loads .env when present. Blank AI key + model selects practice mode.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/interview.sqlite
NODE_ENV=development
COOKIE_SECURE=false
# Local default origin. Change to the exact HTTPS public origin when deploying.
APP_ORIGIN=http://127.0.0.1:3000

# Set BOTH key and model to enable AI. The model must support this provider's
# chat-completion and JSON response requirements. Usage may incur charges.
AI_API_KEY=
AI_MODEL=
# Optional override; leave blank to use https://api.openai.com/v1 when AI is enabled.
AI_BASE_URL=
